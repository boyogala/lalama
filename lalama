#!/usr/bin/env bash
# ==============================================================================
# LaLaMa (Large Language Model for Academic) - Linux 一键安装与服务管理脚本
# Github: https://github.com/boyogala/lalama
# 用法:
#   chmod +x lalama
#   ./lalama install   (安装后可直接输入: lalama status | start | stop | restart | help | uninstall)
# ==============================================================================

set -e

# 解析脚本真实所在目录（兼容软链接调用）
SOURCE="${BASH_SOURCE[0]}"
while [ -h "$SOURCE" ]; do
    DIR="$(cd -P "$(dirname "$SOURCE")" >/dev/null 2>&1 && pwd)"
    SOURCE="$(readlink "$SOURCE")"
    [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
done
APP_DIR="$(cd -P "$(dirname "$SOURCE")" >/dev/null 2>&1 && pwd)"

VENV_DIR="${APP_DIR}/pylalama"
PID_FILE="${APP_DIR}/.lalama.pid"
INSTALL_PID_FILE="${APP_DIR}/.lalama_install.pid"
LOG_DIR="${APP_DIR}/gpt_log"
RUN_LOG="${LOG_DIR}/lalama_service.log"
INSTALL_LOG="${LOG_DIR}/lalama_install.log"
BIN_LINK="/usr/local/bin/lalama"
USER_BIN_LINK="${HOME}/.local/bin/lalama"

export PATH="${HOME}/.local/bin:${HOME}/.cargo/bin:/usr/local/bin:${PATH}"
mkdir -p "${LOG_DIR}"

# 颜色定义
GREEN="\033[1;32m"
YELLOW="\033[1;33m"
RED="\033[1;31m"
CYAN="\033[1;36m"
RESET="\033[0m"

register_global_command() {
    chmod +x "${APP_DIR}/lalama" 2>/dev/null || true
    if [ -w "/usr/local/bin" ]; then
        ln -sf "${APP_DIR}/lalama" "${BIN_LINK}" 2>/dev/null || true
    elif command -v sudo >/dev/null 2>&1 && sudo -n true 2>/dev/null; then
        sudo ln -sf "${APP_DIR}/lalama" "${BIN_LINK}" 2>/dev/null || true
    else
        mkdir -p "${HOME}/.local/bin"
        ln -sf "${APP_DIR}/lalama" "${USER_BIN_LINK}" 2>/dev/null || true
        if [[ ":$PATH:" != *":${HOME}/.local/bin:"* ]]; then
            for rc in "${HOME}/.bashrc" "${HOME}/.zshrc" "${HOME}/.profile"; do
                if [ -f "$rc" ] && ! grep -q 'export PATH="$HOME/.local/bin:$PATH"' "$rc" 2>/dev/null; then
                    echo 'export PATH="$HOME/.local/bin:$PATH"' >> "$rc"
                fi
            done
        fi
    fi
}

is_running() {
    if [ -f "${PID_FILE}" ]; then
        local pid
        pid="$(cat "${PID_FILE}" 2>/dev/null || true)"
        if [ -n "${pid}" ] && kill -0 "${pid}" 2>/dev/null; then
            return 0
        fi
    fi
    return 1
}

get_listening_port() {
    if [ -f "${RUN_LOG}" ]; then
        grep -oE "http://(127\.0\.0\.1|localhost):[0-9]+" "${RUN_LOG}" | tail -n 1 | awk -F: '{print $NF}' || true
    fi
}

get_listening_url() {
    local port
    port="$(get_listening_port)"
    if [ -n "${port}" ]; then
        echo "http://127.0.0.1:${port}"
    fi
}

do_install_worker() {
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] 开始安装 LaLaMa 环境与依赖..." > "${INSTALL_LOG}"

    if command -v python3.12 >/dev/null 2>&1 && python3.12 -m venv --help >/dev/null 2>&1; then
        echo "[INFO] 检测到系统 python3.12，正在创建虚拟环境..." >> "${INSTALL_LOG}"
        if [ ! -d "${VENV_DIR}" ]; then
            python3.12 -m venv "${VENV_DIR}" >> "${INSTALL_LOG}" 2>&1
        fi
        "${VENV_DIR}/bin/python" -m pip install --upgrade pip -q >> "${INSTALL_LOG}" 2>&1 || true
        "${VENV_DIR}/bin/pip" install "setuptools<80" -q >> "${INSTALL_LOG}" 2>&1
        "${VENV_DIR}/bin/pip" install -r "${APP_DIR}/requirements.txt" -q >> "${INSTALL_LOG}" 2>&1
    else
        if ! command -v uv >/dev/null 2>&1; then
            echo "[INFO] 正在安装 uv 以配置 Python 3.12 运行环境..." >> "${INSTALL_LOG}"
            curl -LsSf https://astral.sh/uv/install.sh | sh >> "${INSTALL_LOG}" 2>&1
            export PATH="${HOME}/.local/bin:${HOME}/.cargo/bin:${PATH}"
        fi
        echo "[INFO] 正在使用 uv 创建 Python 3.12 虚拟环境..." >> "${INSTALL_LOG}"
        uv venv --python 3.12 --seed "${VENV_DIR}" >> "${INSTALL_LOG}" 2>&1
        uv pip install --python "${VENV_DIR}/bin/python" "setuptools<80" >> "${INSTALL_LOG}" 2>&1
        uv pip install --python "${VENV_DIR}/bin/python" -r "${APP_DIR}/requirements.txt" >> "${INSTALL_LOG}" 2>&1
    fi

    echo "[$(date '+%Y-%m-%d %H:%M:%S')] 依赖安装完成，正在后台启动 LaLaMa 服务..." >> "${INSTALL_LOG}"
    rm -f "${INSTALL_PID_FILE}"
    do_start_silent
}

do_start_silent() {
    if is_running; then
        return 0
    fi
    if [ ! -x "${VENV_DIR}/bin/python" ]; then
        echo -e "${RED}[错误] 尚未完成环境安装，请先运行: lalama install${RESET}"
        exit 1
    fi
    : > "${RUN_LOG}"
    cd "${APP_DIR}"
    nohup "${VENV_DIR}/bin/python" -u "${APP_DIR}/main.py" >> "${RUN_LOG}" 2>&1 &
    echo $! > "${PID_FILE}"
}

cmd_install() {
    register_global_command
    if [ -f "${INSTALL_PID_FILE}" ] && kill -0 "$(cat "${INSTALL_PID_FILE}" 2>/dev/null)" 2>/dev/null; then
        echo -e "${YELLOW}[提示] LaLaMa 正在后台静默安装中 (PID: $(cat "${INSTALL_PID_FILE}"))，可通过 'lalama status' 或 'lalama logs' 查看进度。${RESET}"
        exit 0
    fi
    nohup bash "${APP_DIR}/lalama" _install_worker >/dev/null 2>&1 &
    local bg_pid=$!
    echo "${bg_pid}" > "${INSTALL_PID_FILE}"
    echo -e "${GREEN}[LaLaMa] 已在后台启动静默自动安装与部署 (安装进程 PID: ${bg_pid})${RESET}"
    echo -e "  - 查看安装与运行状态: ${CYAN}lalama status${RESET}"
    echo -e "  - 查看实时安装日志:   ${CYAN}lalama logs${RESET}"
}

cmd_start() {
    if is_running; then
        local pid url
        pid="$(cat "${PID_FILE}")"
        url="$(get_listening_url)"
        echo -e "${YELLOW}[提示] LaLaMa 已在运行中 (PID: ${pid}${url:+, 地址: ${url}})${RESET}"
        exit 0
    fi
    do_start_silent
    sleep 2
    local pid url
    pid="$(cat "${PID_FILE}" 2>/dev/null || true)"
    for _ in {1..15}; do
        url="$(get_listening_url)"
        [ -n "${url}" ] && break
        sleep 1
    done
    if is_running; then
        echo -e "${GREEN}[LaLaMa] 服务启动成功!${RESET}"
        echo -e "  - 进程 PID: ${CYAN}${pid}${RESET}"
        [ -n "${url}" ] && echo -e "  - 访问地址: ${CYAN}${url}${RESET}"
    else
        echo -e "${RED}[错误] LaLaMa 启动失败，请运行 'lalama logs' 查看日志。${RESET}"
        exit 1
    fi
}

cmd_stop() {
    if is_running; then
        local pid
        pid="$(cat "${PID_FILE}")"
        kill "${pid}" 2>/dev/null || true
        for _ in {1..10}; do
            if ! kill -0 "${pid}" 2>/dev/null; then
                break
            fi
            sleep 0.5
        done
        kill -9 "${pid}" 2>/dev/null || true
        rm -f "${PID_FILE}"
        echo -e "${GREEN}[LaLaMa] 服务已停止 (原 PID: ${pid})。${RESET}"
    else
        rm -f "${PID_FILE}"
        echo -e "${YELLOW}[提示] LaLaMa 当前未运行。${RESET}"
    fi
}

cmd_restart() {
    cmd_stop
    cmd_start
}

cmd_status() {
    echo -e "${CYAN}==================== LaLaMa 状态面板 ====================${RESET}"
    echo -e "项目目录:     ${APP_DIR}"
    if [ -f "${INSTALL_PID_FILE}" ] && kill -0 "$(cat "${INSTALL_PID_FILE}" 2>/dev/null)" 2>/dev/null; then
        echo -e "安装状态:     ${YELLOW}正在后台静默安装中 (PID: $(cat "${INSTALL_PID_FILE}"))${RESET}"
    elif [ -x "${VENV_DIR}/bin/python" ]; then
        echo -e "虚拟环境:     ${GREEN}已就绪 (${VENV_DIR})${RESET}"
    else
        echo -e "虚拟环境:     ${RED}未安装 (请执行 'lalama install')${RESET}"
    fi

    if is_running; then
        local pid url uptime_str
        pid="$(cat "${PID_FILE}")"
        url="$(get_listening_url)"
        uptime_str="$(ps -o etime= -p "${pid}" 2>/dev/null | xargs || true)"
        echo -e "运行状态:     ${GREEN}运行中 (Running)${RESET}"
        echo -e "进程 PID:     ${pid}"
        [ -n "${uptime_str}" ] && echo -e "运行时长:     ${uptime_str}"
        [ -n "${url}" ] && echo -e "监听地址:     ${GREEN}${url}${RESET}"
    else
        echo -e "运行状态:     ${YELLOW}已停止 (Stopped)${RESET}"
    fi
    echo -e "${CYAN}=========================================================${RESET}"
}

cmd_logs() {
    if [ -f "${INSTALL_PID_FILE}" ] && kill -0 "$(cat "${INSTALL_PID_FILE}" 2>/dev/null)" 2>/dev/null; then
        echo -e "${CYAN}=== 正在显示安装日志 (${INSTALL_LOG}) ===${RESET}"
        tail -n 50 "${INSTALL_LOG}" 2>/dev/null || true
    elif [ -f "${RUN_LOG}" ]; then
        echo -e "${CYAN}=== 正在显示服务运行日志 (${RUN_LOG}) ===${RESET}"
        tail -n 50 "${RUN_LOG}"
    else
        echo -e "${YELLOW}[提示] 暂无日志文件。${RESET}"
    fi
}

cmd_uninstall() {
    echo -e "${YELLOW}[LaLaMa] 正在停止服务并卸载虚拟环境...${RESET}"
    cmd_stop >/dev/null 2>&1 || true
    if [ -f "${INSTALL_PID_FILE}" ]; then
        kill -9 "$(cat "${INSTALL_PID_FILE}" 2>/dev/null)" 2>/dev/null || true
        rm -f "${INSTALL_PID_FILE}"
    fi
    rm -rf "${VENV_DIR}" "${PID_FILE}" "${INSTALL_PID_FILE}"
    rm -f "${BIN_LINK}" "${USER_BIN_LINK}" 2>/dev/null || true
    if command -v sudo >/dev/null 2>&1 && sudo -n true 2>/dev/null; then
        sudo rm -f "${BIN_LINK}" 2>/dev/null || true
    fi
    echo -e "${GREEN}[LaLaMa] 卸载完成（已清理虚拟环境 pylalama 及全局命令软链接，保留项目源码与配置）。${RESET}"
}

cmd_help() {
    cat <<EOF
LaLaMa (Large Language Model for Academic) 命令行管理工具

使用方法:
  lalama <command>

可用参数命令列表:
  install     在后台静默创建虚拟环境、安装依赖、注册全局 lalama 命令并自动启动服务
  start       在后台启动 LaLaMa 服务并输出本地访问地址 (127.0.0.1:端口)
  stop        停止正在后台运行的 LaLaMa 服务
  restart     重启 LaLaMa 服务
  status      查看 LaLaMa 当前安装状态、运行状态、PID 及监听端口
  logs        查看最近的服务运行日志或安装日志
  uninstall   停止服务并卸载虚拟环境及全局命令软链接
  help        显示本帮助信息与参数列表

首次使用示例:
  chmod +x lalama
  ./lalama install
  lalama status
  lalama help
EOF
}

case "${1:-help}" in
    _install_worker)
        do_install_worker
        ;;
    install)
        cmd_install
        ;;
    start)
        cmd_start
        ;;
    stop)
        cmd_stop
        ;;
    restart)
        cmd_restart
        ;;
    status)
        cmd_status
        ;;
    logs|log)
        cmd_logs
        ;;
    uninstall|remove)
        cmd_uninstall
        ;;
    help|--help|-h)
        cmd_help
        ;;
    *)
        echo -e "${RED}[错误] 未知参数: $1${RESET}"
        echo ""
        cmd_help
        exit 1
        ;;
esac
